{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextain.io/nva/0.3/schema.json",
  "title": "NVA completed-media manifest (v0.3)",
  "description": "A GPU-free playback package containing finished idle, action, and speech videos.",
  "type": "object",
  "required": ["nva_version", "profile", "canvas", "animations", "speech_clips"],
  "additionalProperties": false,
  "properties": {
    "nva_version": { "const": "0.3" },
    "profile": { "const": "completed-media" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "author": { "type": "string" },
        "owner": { "type": "string" },
        "license": { "type": "string" },
        "created": { "type": "string" },
        "description": { "type": "string" },
        "tagline": { "type": "string" },
        "persona": { "type": "object" },
        "delivery": {
          "type": "object",
          "required": ["kind", "realtime"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "completed-media" },
            "realtime": { "const": false }
          }
        }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1, "default": 25 }
      }
    },
    "background": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["color", "image", "video", "transparent"] },
        "color": { "type": "string" },
        "src": { "$ref": "#/$defs/bundlePath" }
      }
    },
    "poses": { "type": "array", "items": { "type": "string" } },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["clip", "loop"],
        "additionalProperties": false,
        "properties": {
          "clip": { "$ref": "#/$defs/bundlePath" },
          "loop": { "type": "boolean" },
          "entry_pose": { "type": "string" },
          "exit_pose": { "type": "string" },
          "label": { "type": "string" },
          "intent": { "type": "string" },
          "triggers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "speech_clips": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["clip", "audio", "language", "label"],
        "additionalProperties": false,
        "properties": {
          "clip": { "$ref": "#/$defs/bundlePath" },
          "audio": { "const": "embedded" },
          "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
          "label": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "maxLength": 10000 },
          "duration_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "expressions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["start", "scene"] },
              "animation": { "type": "string" },
              "label": { "type": "string" },
              "dwell_ms": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bundlePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
